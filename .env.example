# ---- Backend (Supabase Edge Function secrets) ----
# On Supabase these are injected automatically: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_URL
# Local development only:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/credit_savings
APP_JWT_SECRET=dev-secret-0123456789-change-me
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
DEMO_MODE=true
# Business profile printed on statements (also editable in the app under Settings)
BUSINESS_NAME=Kampala Community Savings & Credit
BUSINESS_ADDRESS=Nakawa, Ntinda, Kampala, Uganda
BUSINESS_PHONE=+256 755 274 944
BUSINESS_EMAIL=info@gss-tec.com
BUSINESS_LOGO_TEXT=KCS

# ---- Customer email notifications (Resend) ----
# Leave RESEND_API_KEY empty to record messages without sending them.
RESEND_API_KEY=
MAIL_FROM=Kampala Community Savings & Credit <no-reply@example.com>

# ---- Frontend (web/.env.local or Vercel env) ----
# Leave NEXT_PUBLIC_API_URL empty to run the built-in offline demo (no backend needed).
NEXT_PUBLIC_API_URL=
